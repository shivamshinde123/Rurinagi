{
  "name": "rurinagi",
  "productName": "Rurinagi",
  "version": "1.0.0",
  "description": "A calm, private Windows focus and planning app.",
  "main": ".vite/build/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
